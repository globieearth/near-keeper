# --- client (Expo) -----------------------------------------------------------
# Where the Fastify API lives. Leave empty to use the built-in defaults:
#   dev  -> http://localhost:3001
#   prod -> https://near-keeperapi.globie.ai
EXPO_PUBLIC_API_URL=

# --- database ----------------------------------------------------------------
POSTGRES_USER=globie
POSTGRES_PASSWORD=globie
POSTGRES_DB=globie
# 55432 keeps the container off the host's own PostgreSQL on 5432.
DB_PORT=55432
DATABASE_URL=postgres://globie:globie@localhost:55432/globie

# --- api ---------------------------------------------------------------------
API_PORT=3001
# The API and the SPA live on separate hostnames in production; the API needs
# both so it can accept browser calls from the web app and build absolute
# wallet callback URLs.
PUBLIC_ORIGIN=https://near-keeperapi.globie.ai
WEB_ORIGIN=https://near-keeper.globie.ai
# Extra browser origins to allow, comma-separated (previews, staging, ...).
CORS_ORIGINS=
SESSION_TTL_DAYS=60
AUTO_MIGRATE=true
# Signs the agent's confirmation tokens; required when NODE_ENV=production.
# Generate with: openssl rand -hex 32
AGENT_CONFIRMATION_SECRET=

# --- reverse proxy -----------------------------------------------------------
# Only used by the bundled single-origin proxy (docker-compose.yml); Easypanel
# terminates TLS itself and routes each subdomain to the api/web service.
PROXY_PORT=8080
PROXY_TLS_PORT=443

# --- NEAR (the settlement rail) -----------------------------------------------
# `testnet` while developing, `mainnet` for the one real micro-settlement the
# submission points an explorer at. Amounts stay in the database as ISO minor
# units; only lib/near.ts converts them to the token's own decimals.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# NEP-141 token members pay with — put the contract you actually funded here.
# (USDC on NEAR is 6 decimals; the testnet deployment you use must match.)
NEAR_USDC_CONTRACT=
NEAR_USDC_DECIMALS=6
# Read-only account used for RPC lookups; it never signs or holds funds.
NEAR_SERVER_ACCOUNT=
# Shared agreement registry (contracts/agreements). Members call
# `record_acceptance` to publish their own signature; empty disables the path.
NEAR_AGREEMENTS_CONTRACT=
# NEAR Intents (1Click) has no testnet deployment, so this stays empty unless
# NEAR_NETWORK=mainnet. Empty disables the cross-chain quote path.
NEAR_INTENTS_BASE_URL=
# Defaults to https://testnet.nearblocks.io (testnet) or https://nearblocks.io.
# NEAR_EXPLORER_URL=

# Log in with a NEAR wallet (NEP-413 signed message, no key on the server).
# The wallet returns to `callbackUrl` with the signature in the URL fragment, so
# the web return must be a page that reads `#accountId=…&publicKey=…&signature=…`
# and the native return is the deep link openAuthSessionAsync resolves with.
# NEAR_LOGIN_WEB_RETURN_URL=      # ${WEB_ORIGIN}/near/login
# NEAR_LOGIN_NATIVE_RETURN_URL=   # globiekeeper://auth/near

# Client-side: base URL of the Meteor Wallet web app (one of three entries in
# lib/wallets.ts — Nightly and Sender are extensions with fixed URLs). Meteor is
# the advised default. Must be readable by Expo, hence the EXPO_PUBLIC_ prefix.
# EXPO_PUBLIC_NEAR_WALLET_URL=https://wallet.meteorwallet.app

# --- Globie Fund (adopt a tree) ----------------------------------------------
# The sanctuary's own NEAR account. Donors transfer USDC (NEP-141) or native
# NEAR straight to it — there is no checkout session and no processor in the
# middle. Empty hides the pay button instead of pointing a wallet nowhere.
GLOBIE_FUND_TREASURY_ACCOUNT=
# How long a frozen gift quote stays settleable. The wallet signs an exact
# integer, so a slow donor asks for a fresh quote rather than sending an amount
# the chain would verify against a stale price.
GLOBIE_FUND_QUOTE_TTL_MS=900000

# --- Globie MCP (Living Deeds) -----------------------------------------------
# mcp.globie.earth speaks streamable HTTP MCP at /mcp and authenticates with a
# plain device id header. `adopt_species` writes the deed number after the
# transfer is already proven, so an outage here never blocks a donation.
MCP_GLOBIE_EARTH_URL=https://mcp.globie.earth
MCP_SESSION_DEVICE_ID=
MCP_TIMEOUT_MS=10000

# --- AI (NEAR AI Cloud) ------------------------------------------------------
# One OpenAI-compatible key serves receipt parsing and Globie's voice. Create it
# at cloud.near.ai -> dashboard -> API keys. Empty falls back to manual entry
# for receipts and to the tools' own wording for chat.
NEAR_AI_API_KEY=
# Base URL or full `/chat/completions` path — both work.
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# AGENT_MODEL=google/gemini-2.5-flash-lite

# --- jobs (pg-boss, runs inside the API process) ------------------------------
# JOBS_ENABLED=false turns the workers off for one-shot scripts.
JOBS_ENABLED=true
REMINDER_SWEEP_CRON=*/5 * * * *
OUTBOX_SWEEP_CRON=* * * * *

# --- notifications -----------------------------------------------------------
# In-app is always on. The rest stay off until credentials exist.
NOTIFY_IN_APP=true
NOTIFY_EMAIL=false
NOTIFY_PUSH=false
NOTIFY_WHATSAPP=false

# smtp://user:pass@host:587 or smtps://user:pass@host:465
SMTP_URL=
MAIL_FROM=Globie <no-reply@globie.local>

EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
